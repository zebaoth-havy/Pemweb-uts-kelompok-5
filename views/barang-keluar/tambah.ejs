
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- CREATE: Form untuk menambah transaksi -->
  <h1>Tambah Barang Keluar</h1>

  <form action="/barang-keluar/tambah" method="POST">

    <!-- Memilih barang dari database -->
    <label for="barang_id">Nama Barang</label>
    <select id="barang_id" name="barang_id" required>
      <option value="">-- Pilih Barang --</option>
      <% barang.forEach((item) => { %>
        <option value="<%= item.id %>">
          <%= item.nama %> (Stok: <%= item.stok %>)
        </option>
      <% }) %>
    </select>

    <br><br>

    <!-- Mengisi tanggal transaksi -->
    <label for="tanggal">Tanggal Keluar</label>
    <input
      type="date"
      id="tanggal"
      name="tanggal"
      required
    >

    <br><br>

    <!-- Mengisi jumlah barang keluar -->
    <label for="jumlah">Jumlah Keluar</label>
    <input
      type="number"
      id="jumlah"
      name="jumlah"
      min="1"
      step="1"
      required
    >

    <br><br>

    <!-- Mengisi tujuan pengeluaran barang -->
    <label for="tujuan">Tujuan Pengeluaran</label>
    <input
      type="text"
      id="tujuan"
      name="tujuan"
      maxlength="255"
      required
    >

    <br><br>

    <!-- Mengirim data dengan metode POST -->
    <button type="submit">Simpan</button>

    <a href="/barang-keluar">Batal</a>
  </form>

</body>
</html>
